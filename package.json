{
  "name": "brainflip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brainflip memory game, packaged as a Crumb desktop application",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run scripts/build.ts",
    "build:native": "bun run scripts/build-native.ts",
    "rebuild:extensions": "bun run scripts/rebuild-extensions.ts",
    "build:ui": "bun run scripts/build-ui.ts",
    "extract": "bun run scripts/extract.ts",
    "install:skills": "bun run scripts/install-skills.ts",
    "test": "bun test ./test",
    "typecheck": "bunx tsc --noEmit",
    "assets": "bun run scripts/build-assets.ts",
    "dev:server": "nodemon server/app.js",
    "start:server": "node server/app.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@nativewindow/webview": "1.0.6",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bun": "1.4.0",
    "@types/node": "^24.10.1",
    "nodemon": "^3.1.7",
    "typescript": "7.0.2"
  }
}
